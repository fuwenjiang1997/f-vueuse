{
  "name": "f-vueuse",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "publish:ui": "pnpm --filter @f-vueuse/core publish:ui",
    "lint": "eslint --fix",
    "spellcheck": "cspell lint --dot --gitignore --cache --show-suggestions  \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "keywords": [],
  "author": "Fuwenjiang",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "eslint": "10.3.0",
    "@eslint/js": "10.0.1",
    "globals": "17.6.0",
    "eslint-plugin-vue": "10.9.1",
    "vue-eslint-parser": "10.4.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "@typescript-eslint/parser": "8.59.2",
    "cspell": "10.0.0",
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "husky": "9.1.7",
    "cz-git": "1.13.0",
    "commitizen": "4.3.1",
    "turbo": "2.9.9",
    "np": "11.2.0"
  }
}
