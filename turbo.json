{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build:watch": {
      "dependsOn": ["^build:watch"],
      "outputs": ["dist"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "sandbox": {}
  },
  "ui": "tui"
}
